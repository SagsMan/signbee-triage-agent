{
  "expo": {
    "name": "SignBee",
    "slug": "signbee-triage-agent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/signbee-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#AAF70A"
    },
    "scheme": "signbee-triage-agent",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#AAF70A",
      "translucent": false
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "This helps us match you with the nearest available interpreter, especially for urgent requests."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
